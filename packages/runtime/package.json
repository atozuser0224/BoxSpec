  "dependencies": {
    "@boxspec/change-manager": "workspace:*",
    "@boxspec/core": "workspace:*",
    "@boxspec/shared": "workspace:*",
    "@boxspec/themes": "workspace:*",
    "@boxspec/verifier": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
