{
  "name": "@boxspec/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "default": "./dist/stdio.js"
    }
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "sync-contract": "node ./scripts/sync-contract.mjs",
    "build": "pnpm sync-contract && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm sync-contract && vitest run"
  },
  "dependencies": {
    "@boxspec/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
